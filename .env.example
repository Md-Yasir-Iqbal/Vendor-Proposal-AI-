# --- Groq API (required for AI extraction, risk analysis, and recommendations) -----------
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
# Any currently supported Groq-hosted model works here, e.g. llama-3.3-70b-versatile
GROQ_MODEL=

# Optional tuning (sensible defaults are used if left blank) -------------------------------
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

MAX_EXTRACTION_CHARS=16000
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=vendor_proposals
RETRIEVAL_TOP_K=4

APP_ENV=development
LOG_LEVEL=INFO

# --- Authentication / email ---------------------------------------------------------------
# Gmail requires a Google App Password (not your normal Gmail password).
SQLITE_DB_PATH=data/vendor_proposal_ai.sqlite3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
